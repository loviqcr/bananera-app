# Copiar a .env y completar antes de arrancar el backend.

# Conexion a PostgreSQL
DATABASE_URL=postgres://usuario:password@localhost:5432/bananera

# Firma de tokens JWT (usar un valor largo y aleatorio en produccion)
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=12h
JWT_REFRESH_SECRET=cambia-este-otro-valor-tambien
JWT_REFRESH_EXPIRES_IN=30d

# Puerto del servidor HTTP
PORT=3000

# Usuario administrador inicial (usado solo por `npm run seed`)
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambiar123
ADMIN_NOMBRE=Administrador

# Origenes permitidos para CORS, separados por coma (ej: la URL donde se
# publique la PWA)
CORS_ORIGINS=*
